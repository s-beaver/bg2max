<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BG2MAX Ответ"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textColor="#666666" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Показания из xDrip+ отправляются в выбранный чат MAX ответом из уведомления — от имени аккаунта MAX на этом телефоне. Бот и токен не нужны. Экспериментальная версия.\n\nВ xDrip+: Настройки → Настройки интеграций с приложениями → включите «Локальная трансляция данных». В поле «Установить получателя» укажите com.bg2max.app.reply или оставьте его пустым."
            android:textSize="13sp"
            android:textColor="#666666" />

        <!-- Шаг 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Доступ к уведомлениям"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAccess"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Открыть настройки доступа" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Если переключатель серый и Android пишет «Ограниченная настройка»: О приложении → ⋮ → «Разрешить ограниченные настройки». На Xiaomi/HyperOS такого пункта нет — переустановите APK через приложение SAI (Split APKs Installer)."
            android:textSize="12sp"
            android:textColor="#666666" />

        <!-- Шаг 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Чат для показаний"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPickChat"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Выбрать чат" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Попросите получателя (например, родителя) написать на этот телефон любое сообщение в MAX. Чат не должен быть без звука, уведомления MAX должны быть включены. Когда уведомление придёт — нажмите «Выбрать чат». Показания будут уходить только в этот чат."
            android:textSize="12sp"
            android:textColor="#666666" />

        <!-- Шаг 3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Работа в фоне"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBattery"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Отключить оптимизацию батареи" />

        <Button
            android:id="@+id/btnAppSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки приложения (автозапуск)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="На Xiaomi: для BG2MAX Ответ и для MAX включите «Автозапуск» и в «Контроле активности» выберите «Нет ограничений»."
            android:textSize="12sp"
            android:textColor="#666666" />

        <include
            android:id="@+id/messageOptions"
            layout="@layout/view_message_options" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сохранить настройки сообщения" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Транслировать в MAX" />

        <Button
            android:id="@+id/btnTestMessage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Отправить тестовое сообщение" />

        <Button
            android:id="@+id/btnSimulateReading"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Симулировать показание (тест без xDrip+)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Последнее показание"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLastReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Журнал"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="«Передано в MAX» значит, что кнопка ответа нажата. Дошло ли сообщение — видно только в чате получателя. Полный журнал за несколько дней — кнопкой «Поделиться журналом»."
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/textLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:textColor="#444444" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShareLog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Поделиться журналом" />

            <Button
                android:id="@+id/btnClearLog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Очистить журнал" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Данные AndroidAPS (диагностика)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAapsDump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:textColor="#444444" />

        <Button
            android:id="@+id/btnDisclaimer"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Отказ от ответственности и лицензия" />

    </LinearLayout>

</ScrollView>
