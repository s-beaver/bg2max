<?xml version="1.0" encoding="utf-8"?>
<!-- Галочки «Что включать в сообщение» — общие для обоих вариантов приложения. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Что включать в сообщение"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:text="Значение глюкозы, стрелка тренда и время отправляются всегда. Заряд и остаток инсулина можно присылать, только когда они ниже порога («если &lt;»); пустое поле — всегда"
        android:textSize="12sp"
        android:textColor="#666666" />

    <CheckBox
        android:id="@+id/checkboxDelta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Изменение с прошлого показания (дельта)" />

    <CheckBox
        android:id="@+id/checkboxRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Скорость изменения (ммоль/л/мин)" />

    <CheckBox
        android:id="@+id/checkboxNoise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Предупреждение о шуме сигнала" />

    <!-- Пустое поле — строка всегда; число — только когда значение ниже него. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkboxBattery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Заряд батареи сенсора" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="если &lt;"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputBatteryBelow"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="—"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="%"
            android:textSize="12sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkboxSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Источник данных (модель CGM)" />

    <CheckBox
        android:id="@+id/checkboxSensorAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Возраст сенсора (дни)" />

    <!-- Блок виден, только если от AndroidAPS хоть раз приходили данные
         (или галочка из него уже включена) — см. MessageOptionsView.refreshAaps. -->
    <LinearLayout
        android:id="@+id/aapsOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Из AndroidAPS"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:text="Если данные от AndroidAPS старше 10 минут, эти строки не добавляются"
        android:textSize="12sp"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/textAapsReceived"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/checkboxIob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Активный инсулин (IOB)" />

    <CheckBox
        android:id="@+id/checkboxCob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Активные углеводы (COB)" />

    <!-- Пустое поле — строка всегда; число — только когда значение ниже него. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkboxReservoir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Остаток инсулина в помпе" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="если &lt;"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputReservoirBelow"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="—"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="Ед"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Пустое поле — строка всегда; число — только когда значение ниже него. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkboxPumpBattery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Заряд батареи помпы" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="если &lt;"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputPumpBatteryBelow"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="—"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="%"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Пустое поле — строка всегда; число — только когда значение ниже него. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkboxPhoneBattery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Заряд батареи телефона" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="если &lt;"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputPhoneBatteryBelow"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="—"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="%"
            android:textSize="12sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkboxProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Профиль AAPS" />

    <CheckBox
        android:id="@+id/checkboxPumpStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Последняя связь с помпой и последний болюс" />

    <CheckBox
        android:id="@+id/checkboxTempBasal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Временная базальная скорость" />

    <CheckBox
        android:id="@+id/checkboxTempBasalTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Время временной базальной скорости (начало, длительность, остаток)" />

    </LinearLayout>

</LinearLayout>
